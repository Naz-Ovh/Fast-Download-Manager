{
  "name": "fdm-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "predev": "node scripts/prebuild/index.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/prebuild/index.mjs",
    "build": "vite build",
    "start": "serve out",
    "precheck": "node scripts/prebuild/index.mjs && node scripts/route-tree.mjs",
    "check": "tsc --noEmit",
    "cf:deploy": "pnpm build && pnpm dlx wrangler@4 deploy",
    "cf:dry-run": "pnpm dlx wrangler@4 deploy --dry-run"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/start-static-server-functions": "1.167.44",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
